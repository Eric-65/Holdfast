# Optional. A Nimiq PoS JSON-RPC endpoint that allows browser (CORS) requests.
# Enables live on-chain stake reading (getStakerByAddress) for the saver and the Goalkeeper.
# Without it Holdfast falls back to its own ledger + the snapshot inside the share link.
VITE_NIMIQ_RPC_URL=

# Optional. Origin of the Holdfast API if it is not served from the same site as the app.
VITE_API_BASE=

# Server side (set these on the host, e.g. Vercel project settings; Vercel adds the first two
# automatically when an Upstash Redis database is connected to the project):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# HF_REQUIRE_UNIQUE_DEVICE=1   # only count referrals from devices/browsers new to Holdfast

# Optional overrides
VITE_VALIDATORS_API_URL=https://validators-api-mainnet.nuxt.dev/api/v1/validators
VITE_PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=nimiq-2,tether&vs_currencies=usd,ngn,eur,crc,gmd
